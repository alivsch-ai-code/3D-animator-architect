# Oeffentliche Backend-URL, vom Browser genutzt (im Client-Bundle sichtbar!)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: interne Backend-URL fuer serverseitiges Rendering (Server-
# Komponenten), falls Frontend und Backend auf demselben Host laufen und ein
# Umweg ueber die oeffentliche Domain/DNS vermieden werden soll. Faellt sonst
# auf NEXT_PUBLIC_API_BASE_URL zurueck. Siehe lib/api.ts.
API_BASE_URL_INTERNAL=http://127.0.0.1:8000
