# Parser-Provider: claude (Empfehlung) | gemini | replicate
PARSER_PROVIDER=claude
ANTHROPIC_API_KEY=
PARSER_MODEL=claude-opus-5
CHAT_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_PARSER_MODEL=gemini-3-pro

REPLICATE_API_TOKEN=
REPLICATE_PARSER_MODEL=anthropic/claude-opus-4.6

# Render-Provider: preview (kein Key noetig) | replicate
RENDER_PROVIDER=preview
REPLICATE_IMAGE_MODEL=google/nano-banana

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
